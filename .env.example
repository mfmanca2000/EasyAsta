# Database
DATABASE_URL="postgresql://user:password@localhost:5432/easyasta"

# Pool connessioni Prisma (opzionali).
# In serverless (Vercel) connection_limit vale 1 di default per evitare di
# saturare il numero massimo di client del database (errore EMAXCONN).
# I parametri gia' presenti nella DATABASE_URL hanno sempre la precedenza.
# DATABASE_CONNECTION_LIMIT="1"
# DATABASE_POOL_TIMEOUT="20"     # secondi di attesa per una connessione dal pool
# DATABASE_CONNECT_TIMEOUT="10"  # secondi di attesa per aprire una connessione

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # generate: openssl rand -base64 32

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pusher (https://pusher.com) - used for real-time if Socket.io not available
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_APP_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
